
# Default = CPU wheels (smallest). Override per the header for a GPU build.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu


ARG PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.11-slim

# ---- Stage 1: builder — resolve deps into a self-contained venv ----
FROM ${PYTHON_IMAGE} AS builder
ARG TORCH_INDEX_URL

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Install torch/torchaudio FIRST from the selected index so the CPU-vs-CUDA variant
# is pinned before the rest of the tree resolves torch. The version range matches
# requirements-worker.txt, so the subsequent `-r` leaves this wheel untouched
# instead of re-pulling a default-index (wrong-variant) build.
RUN pip install --index-url ${TORCH_INDEX_URL} "torch>=2.11,<2.12" "torchaudio>=2.11,<2.12"

COPY requirements.txt requirements-worker.txt ./
RUN pip install -r requirements-worker.txt

# ---- Stage 2: runtime — slim final image, no build tooling / pip cache ----
FROM ${PYTHON_IMAGE} AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TORCH_HOME=/cache/torch \
    PATH="/opt/venv/bin:$PATH"

# libsndfile1: audio decoding for soundfile. ffmpeg is optional (only for exotic
# formats like M4A/WMA that libsndfile can't read) — add it if you need them.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The built venv (torch/demucs/…) is the only heavy artifact carried over.
COPY --from=builder /opt/venv /opt/venv

# Worker-only import closure (verified): engine + worker + the shared core/models/
# repositories/schemas layers. The API (app/api), app/main.py and app/services are
# NOT part of the worker's graph, so they're intentionally left out of this image.
# When a new package enters the worker's imports, add it here.
COPY app/core ./app/core
COPY app/models ./app/models
COPY app/repositories ./app/repositories
COPY app/schemas ./app/schemas
COPY app/engine ./app/engine
COPY app/worker ./app/worker
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic

# Drop root; pre-create the model cache dir owned by the unprivileged user.
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /cache/torch \
    && chown -R appuser:appuser /cache /app
USER appuser

# Model weights (~400 MB: htdemucs_ft + htdemucs_6s) download here on first run.
# Mount a volume to persist them across restarts.
VOLUME ["/cache/torch"]

# Needs the same env as the API (POSTGRES_* / AWS_* / S3_* …) so it can reach
# Postgres + S3, plus WORKER_DEVICE=cuda on a GPU host.
CMD ["python", "-m", "app.worker"]
