APP_ENV=local
CORS_ORIGINS=*
LOG_LEVEL=INFO

SECRET_KEY=
# JWT_ISSUER=ai-audio-stem-api
# JWT_AUDIENCE=ai-audio-stem-api-clients
# Access tokens stay short-lived on purpose — the client silently exchanges a
# refresh token for a new one, so raising this weakens security without
# improving UX. It is the refresh window below that keeps a user signed in.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# Inactivity window: every refresh issues a new token, so an active user's
# session keeps rolling forward. Must be >= the frontend's refresh cookie Max-Age.
# REFRESH_TOKEN_EXPIRE_DAYS=30
# PBKDF2_ITERATIONS=600000
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Legacy — unused. Keep blank unless falling back to the legacy DB URLs below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Both may point at one bucket; the key layouts don't overlap.
# S3_BUCKET_INPUTS=audio-inputs
# S3_BUCKET_STEMS=audio-stems
# Profile avatars. Blank => reuse S3_BUCKET_INPUTS (avatars live under an
# avatars/ key prefix), so no separate bucket/CORS setup is needed. Set only to
# isolate avatars in their own bucket.
# S3_BUCKET_AVATARS=
# S3_UPLOAD_URL_EXPIRE_SECONDS=3600

# Fallback ceiling used only when a user's plan can't be resolved. Not a clamp — each
# presign carries the user's own plans.max_file_size_mb, so raise a tier via the plan row.
# MAX_UPLOAD_SIZE_BYTES=52428800
# Set POSTGRES_HOST to switch the app and Alembic off the legacy DATABASE_URL(s).
POSTGRES_TYPE=postgres
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=postgres
POSTGRES_SSL=true
POSTGRES_LOG=false

RESEND_API_KEY=

EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=AI Audio Stem
FRONTEND_URL=http://localhost:3000

REQUIRE_EMAIL_VERIFICATION=true

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` or the dashboard endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# BILLING_SUCCESS_URL=http://localhost:3000/billing/success
# BILLING_CANCEL_URL=http://localhost:3000/billing
# BILLING_PORTAL_RETURN_URL=http://localhost:3000/billing
# STRIPE_API_BASE_URL=https://api.stripe.com


WORKER_DEVICE=auto
# Downloaded to TORCH_HOME on first run (~400 MB total).
DEMUCS_MODEL=htdemucs_ft
INSTRUMENTS_MODEL=htdemucs_6s
# Optional stages — turn either off for faster/cheaper jobs.
ENABLE_INSTRUMENTS=true
ENABLE_ENHANCEMENT=true

# Only return stems the track actually contains (see docs/empty-stem-filter.md).
# A stem is written only if it clears BOTH floors: an absolute peak floor and its
# loudest 1 s window measured against the mix's RMS. false = old fixed 9-stem set.
STEM_FILTER_ENABLED=true
STEM_SILENCE_PEAK_DBFS=-50.0
# Toward -30 prunes more aggressively, toward -45 keeps more.
STEM_SILENCE_RELATIVE_RMS_DB=-38.0
STEM_SILENCE_WINDOW_SECONDS=1.0
# Comma-separated stems never dropped, whatever the measurement says.
STEM_FILTER_ALWAYS_KEEP=

# --- Engine versions / A-B (docs/stem-quality-v2.md) ---
# THE deployment knob. Which engine versions THIS container claims from the shared queue.
# The v1 service sets "v1"; the v2 service sets "v2" (Dockerfile.worker.v2 defaults it).
# A v2 job claimed by a v1 image runs the wrong model and mislabels the output, so never
# widen the v1 fleet to "v1,v2". Blank = claim anything (single-fleet deploys).
WORKER_ENGINE_VERSIONS=v1
# Which version a newly enqueued job is stamped with.
ENGINE_VERSION_DEFAULT=v1
# Dual-run: enqueue BOTH v1 and v2 per request so the UI can compare. Two full renders.
ENGINE_AB_ENABLED=false
ENGINE_AB_PERCENT=0
# User ids that always dual-run (the internal team), comma-separated.
ENGINE_AB_USER_ALLOWLIST=

# --- v2 engine (Mel-Band RoFormer) ---
# NOTE: the leaderboard-topping "BS Roformer 124 bands (2026.07)" has NO public weights —
# it is MVSep-hosted only and cannot be self-hosted. This is the best downloadable model.
# Pin the checksum: run `python -m scripts.fetch_v2_weights` and paste the hash it prints.
# Blank = the download is not integrity-checked (warned on every load).
V2_VOCALS_CKPT_SHA256=
# Blank = <TORCH_HOME>/v2, i.e. the /cache/torch volume the worker already mounts.
V2_WEIGHTS_DIR=
# Seam smoothing: 2 is the config default, 4 is a good prod value (linearly slower).
V2_OVERLAP=2
# Chunks per forward pass — the main VRAM dial. Drop to 1 on CUDA OOM.
V2_BATCH_SIZE=4
# Rebuild "other" as mix - roformer_vocals - drums - bass instead of using Demucs' own,
# which carries Demucs' vocal-separation error as bleed.
V2_RECOMPUTE_OTHER=true

WORKER_POLL_INTERVAL_SECONDS=5
# Progress-write debounce (RCA-3): sample every POLL, write only on a label change,
# a jump >= MIN_DELTA, or once MIN_INTERVAL has passed (liveness tick).
WORKER_PROGRESS_POLL_SECONDS=2
WORKER_PROGRESS_MIN_DELTA=5
WORKER_PROGRESS_MIN_INTERVAL_SECONDS=10

WORKER_HEARTBEAT_INTERVAL_SECONDS=15
JOB_STALE_TIMEOUT_SECONDS=90
REAPER_INTERVAL_SECONDS=30
WORKER_RUN_REAPER=true
# Scratch dir for a job's temp files; empty => OS temp dir.
JOB_SCRATCH_DIR=
