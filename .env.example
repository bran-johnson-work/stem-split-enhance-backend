APP_ENV=local
CORS_ORIGINS=*
LOG_LEVEL=INFO

# JWT auth — REQUIRED in non-local envs (app refuses to boot without it).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional overrides (defaults shown):
# JWT_ISSUER=ai-audio-stem-api
# JWT_AUDIENCE=ai-audio-stem-api-clients
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# PBKDF2_ITERATIONS=600000
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Supabase — Settings → API. Postgres only; object storage is on S3 (below).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS S3 object storage ---
# Local dev against LocalStack (no AWS account needed):
#   docker run --rm -p 4566:4566 localstack/localstack
#   python -m scripts.init_storage
# LocalStack ignores the credential values but boto3 still requires them to be set.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# For real AWS: leave AWS_ENDPOINT_URL empty, set real keys, and note that bucket
# names are globally unique across all AWS accounts — suffix them.
# S3_BUCKET_INPUTS=audio-inputs
# S3_BUCKET_STEMS=audio-stems
# S3_UPLOAD_URL_EXPIRE_SECONDS=3600

# Fallback upload ceiling in bytes, used only when a user's plan can't be resolved
# (i.e. the 'free' plan row isn't seeded). Normally each presigned POST carries the
# user's OWN plan limit (plans.max_file_size_mb) in its content-length-range, and
# S3 enforces it — so raise a tier's limit by editing the plan row, not this.
# Default (unset) = 50 MB.
# MAX_UPLOAD_SIZE_BYTES=52428800

# Supabase Postgres — Settings → Database
# Direct connection (port 5432) — used by Alembic only
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Pooled connection (port 6543) — used by the app
DATABASE_URL_POOLED=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Email (Resend — https://resend.com/api-keys). Leave RESEND_API_KEY empty to
# disable outbound email (sends become logged no-ops — handy for local/dev).
RESEND_API_KEY=
# EMAIL_FROM must be on a domain verified in Resend. "onboarding@resend.dev" is
# Resend's shared sandbox sender — works without a verified domain for testing.
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=AI Audio Stem
# Frontend that hosts the /verify-email?token=... landing page.
FRONTEND_URL=http://localhost:3000
# Block login until the email is verified. Set to false for local testing when
# email can't be delivered (Resend sandbox). In local env the verification link
# is logged at startup of the send, so you can verify manually either way.
REQUIRE_EMAIL_VERIFICATION=true
# Optional overrides (defaults shown):
# RESEND_API_BASE_URL=https://api.resend.com
# EMAIL_TIMEOUT_SECONDS=10
# EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- Billing (Stripe — https://dashboard.stripe.com/apikeys) ---
# Leave STRIPE_SECRET_KEY empty to disable billing (checkout/portal -> 503,
# webhook -> 404), keeping local/dev network-free. Use test keys (sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from `stripe listen` or the dashboard endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Where Checkout / the Customer Portal return the user (default to FRONTEND_URL).
# BILLING_SUCCESS_URL=http://localhost:3000/billing/success
# BILLING_CANCEL_URL=http://localhost:3000/billing
# BILLING_PORTAL_RETURN_URL=http://localhost:3000/billing
# STRIPE_API_BASE_URL=https://api.stripe.com

# --- Stem-separation engine + worker (used by `python -m app.worker`) ---
# Separation models (downloaded to TORCH_HOME on first run, ~400 MB total).
DEMUCS_MODEL=htdemucs_ft
INSTRUMENTS_MODEL=htdemucs_6s
# Optional stages. Turn either off for faster/cheaper jobs.
ENABLE_INSTRUMENTS=true
ENABLE_ENHANCEMENT=true
# How often an idle worker polls the queue (seconds).
WORKER_POLL_INTERVAL_SECONDS=5
# Progress-write debounce (RCA-3). The relay loop samples engine progress every
# WORKER_PROGRESS_POLL_SECONDS; a sample is only written to the DB on a stage/label
# change, a jump of >= WORKER_PROGRESS_MIN_DELTA percent, or once
# WORKER_PROGRESS_MIN_INTERVAL_SECONDS have passed (a liveness tick).
WORKER_PROGRESS_POLL_SECONDS=2
WORKER_PROGRESS_MIN_DELTA=5
WORKER_PROGRESS_MIN_INTERVAL_SECONDS=10
# Worker lease / stuck-job recovery (RCA-1). A busy worker heartbeats every
# WORKER_HEARTBEAT_INTERVAL_SECONDS; the reaper reclaims any PROCESSING job whose
# heartbeat is older than JOB_STALE_TIMEOUT_SECONDS (keep it several × the
# interval), sweeping every REAPER_INTERVAL_SECONDS. Set WORKER_RUN_REAPER=false
# on all but one worker if you'd rather a single instance own the sweep.
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
JOB_STALE_TIMEOUT_SECONDS=90
REAPER_INTERVAL_SECONDS=30
WORKER_RUN_REAPER=true
# Scratch dir for a job's temp files; empty => OS temp dir.
JOB_SCRATCH_DIR=
# Save finished stems to this local folder instead of uploading them to Supabase.
# Use this to bypass the Free-plan 50 MB storage cap (large WAV stems get HTTP 413).
# Layout: <dir>/<user_id>/<project_id>/stems/<name>.wav. Empty => upload to Supabase.
# STEMS_LOCAL_DIR=C:/Users/Administrator/Desktop/stems_out
# Where the worker caches model weights (set on the worker host/container).
# TORCH_HOME=/cache/torch
